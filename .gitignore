# Godot C++ build artifacts
/.sconsign.dblite
/src/*.os
/src/*.obj

# Compiled binaries (GitHub Actions will build these automatically)
demo/addons/Tree3D/*.dll
demo/addons/Tree3D/*.so
demo/addons/Tree3D/*.dylib
demo/addons/Tree3D/*.universal
demo/addons/Tree3D/*.exp
demo/addons/Tree3D/*.lib
demo/addons/Tree3D/*.pdb

# macOS binaries (no extension)
demo/addons/Tree3D/libTree3D.macos.template_debug.*
demo/addons/Tree3D/libTree3D.macos.template_release.*

# Godot 4+ specific
/demo/.godot
/demo/*.import
/demo/**/*.import

# Godot C++ submodule (should not be tracked)
godot-cpp/

!/demo/addons/Tree3D/*.gdextension
!/demo/addons/Tree3D/*.gdextension.uid
!/demo/addons/Tree3D/**/*.gdshader
!/demo/addons/Tree3D/**/*.tscn
!/demo/addons/Tree3D/Materials/**
!/demo/addons/Tree3D/ico/**